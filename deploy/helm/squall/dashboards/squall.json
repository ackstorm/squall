        {
          "expr": "(sum(rate(squall_proxy_requests_total{model=~\"$model\",outcome=~\"rejected|failed\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(squall_proxy_requests_total{model=~\"$model\"}[$__rate_interval])), 1e-9)",
