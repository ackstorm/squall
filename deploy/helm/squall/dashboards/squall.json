  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Model namespace",
        "type": "query",
        "query": "label_values(squall_model_phase, exported_namespace)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": [
            "$__all"
          ]
        },
        "definition": "label_values(squall_model_phase, exported_namespace)"
      },
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "query": "label_values(squall_model_phase{exported_namespace=~\"$namespace\"}, name)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": [
            "$__all"
          ]
        },
        "definition": "label_values(squall_model_phase{exported_namespace=~\"$namespace\"}, name)"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
